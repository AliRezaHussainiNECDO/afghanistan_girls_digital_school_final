<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- توجه: مثل src/debug/AndroidManifest.xml — رفع اشکال «launch activity
         not found» دیگر اینجا نیست؛ الان مستقیماً در
         android/app/src/main/AndroidManifest.xml (با android:enabled کنترل‌شده
         توسط manifestPlaceholders در android/app/build.gradle.kts) انجام
         می‌شود. جزئیات کامل در کامنت همان فایل اصلی. -->
</manifest>
