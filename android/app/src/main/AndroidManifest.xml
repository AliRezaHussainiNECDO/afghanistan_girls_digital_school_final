<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── مجوزهای دستگاه (لازم برای انتشار در Play Store) ── -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- مجوزهای لازم برای مسیر صدا/شبکهٔ تماس ویدیویی Jitsi/WebRTC.

         نکتهٔ ۲۰ اوت ۲۰۲۶: مجوزهای بلوتوث (BLUETOOTH/BLUETOOTH_CONNECT) که
         قبلاً اینجا بودند عمداً حذف شدند. علتِ واقعی و تأییدشدهٔ (با
         stack trace واقعی از Logcat) کرشِ «اتاق ویدیوکنفرانس روی گوشی واقعی
         برنامه را می‌بندد» چیز کاملاً دیگری بود: R8 code/resource shrinking
         در build های release (رفع کامل در android/app/build.gradle.kts —
         isMinifyEnabled=false). نظریهٔ قبلی «بدون این مجوزها SecurityException
         بومی در مسیر صدای بلوتوث رخ می‌دهد» هرگز با یک stack trace واقعی
         تأیید نشده بود؛ صرفاً یک احتیاطِ حدسی بود. حذف این دو مجوز هم زمان
         بررسی انتشار در Play Store/App Store را کوتاه‌تر می‌کند و هم اپ را
         از درخواست یک دسترسیِ واقعاً غیرضروری برای کاربران بازمی‌دارد. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Android 14+ (API 34+، که compileSdk=36 این پروژه هم شامل آن است):
         هر سرویس پیش‌زمینه‌ای که از دوربین/میکروفون استفاده کند (سرویس
         «تماس در حال انجام» داخلی Jitsi، JitsiMeetOngoingConferenceService)
         از این پس صراحتاً به این دو مجوز نیاز دارد؛ بدون آن‌ها، تلاش برای
         شروع آن سرویس (دقیقاً لحظهٔ ورود به تماس) با SecurityException رد
         می‌شود. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <!-- نکتهٔ ۲۴ اوت ۲۰۲۶: READ_MEDIA_IMAGES/READ_MEDIA_VIDEO/READ_EXTERNAL_STORAGE عمداً حذف
         شدند (طبق سیاست Google Play دربارهٔ photo/video permissions). انتخاب عکس/ویدیو در کل
         اپ فقط از طریق image_picker (که خودش از Android Photo Picker سیستمی استفاده می‌کند) و
         file_picker (Storage Access Framework) انجام می‌شود — هیچ‌کدام به این مجوزهای گسترده
         نیاز ندارند. اگر در آینده جایی نیاز به دسترسی مستقیم/بدون‌واسطه به MediaStore پیدا شد
         (نه از طریق پیکر سیستمی)، این تصمیم را دوباره بررسی کنید.
    -->

    <!-- دوربین و میکروفون سخت‌افزار اجباری نیستند تا اپ روی همهٔ دستگاه‌ها نصب شود.
         رفع اشکال «آمادگی دستگاه واقعی»: کتابخانهٔ jitsi-meet-sdk/WebRTC خودش یک
         <uses-feature android.hardware.camera required="true"/> در Manifest داخلی‌اش
         دارد که در Merge نهایی روی این خط override می‌شد (تأییدشده با بررسی
         AndroidManifest.xml نهایی در build/app) — یعنی بدون tools:replace زیر،
         هر دستگاهی که دوربین ندارد (مثلاً بعضی تبلت‌ها/Chromebookها) از نصب
         روی Google Play کاملاً فیلتر می‌شد، برخلاف قصد اصلی همین کامنت. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" tools:replace="android:required"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" tools:replace="android:required"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false" tools:replace="android:required"/>

    <application
        tools:replace="android:label"
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enabled="${mainActivityLauncherEnabled}"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />

            <!-- رفع واقعیِ اشکال «flutter run» → «package identifier or launch
                 activity not found»: تلاش قبلی (افزودن intent-filter فقط در
                 src/debug و src/profile) کار نمی‌کرد، چون ابزار flutter تشخیص
                 launch activity را با پارس مستقیمِ همین فایل (main/AndroidManifest.xml)
                 انجام می‌دهد — قبل از این‌که Gradle آن overlay ها را merge کند
                 و همچنین activity-alias را اصلاً نمی‌شناسد (این یک محدودیت
                 شناخته‌شده و هنوز رفع‌نشدهٔ خودِ Flutter است، نگاه کنید:
                 github.com/flutter/flutter/issues/80532 و
                 github.com/flutter/flutter/issues/134018). پس این intent-filter
                 باید مستقیماً روی خودِ MainActivity در همین فایل اصلی باشد تا
                 flutter آن را پیدا کند — اما برای این‌که در نسخهٔ release آیکون
                 اضافه (علاوه بر نمایهٔ واقعی/ماشین‌حساب) در Launcher ظاهر نشود و
                 قابلیت «حالت پنهان» سالم بماند، فعال/غیرفعال بودن خودِ این
                 intent-filter با android:enabled="${mainActivityLauncherEnabled}"
                 کنترل می‌شود: در android/app/build.gradle.kts این مقدار برای
                 debug/profile به "true" و برای release به "false" ست شده است.
                 نتیجه: در debug/profile یک آیکون توسعه اضافه (بی‌ضرر) دیده
                 می‌شود تا flutter run/attach کار کند؛ در release فقط همان
                 activity-alias فعال (نمایهٔ واقعی یا ماشین‌حساب) دیده می‌شود،
                 دقیقاً مثل قبل. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ── نمایه‌های «حالت پنهان» ────────────────────────────────────────
             طبق درخواست صریح کاربر: یک گزینهٔ امنیتی در پروفایل که با نگه‌
             داشتن دکمهٔ صدا-کم برای ۳ ثانیه، آیکون/نامِ برنامه در صفحهٔ اصلی و
             App Drawer گوشی را از برند واقعی به یک «ماشین‌حساب» بی‌ضرر تغییر
             می‌دهد — نه فقط صفحهٔ داخلی اپ، بلکه خودِ نمایهٔ launcher. هر دو
             alias زیر به همان MainActivity اشاره می‌کنند (کد یکسان اجرا
             می‌شود)؛ فقط یکی از این دو در هر لحظه enabled است — سوییچ با
             PackageManager.setComponentEnabledSetting در MainActivity.kt
             انجام می‌شود. پیش‌فرض نصب: نمایهٔ واقعی فعال (کاربر باید یک‌بار
             از پروفایل، «حالت پنهان» را روشن کند). intent-filter اصلیِ
             LAUNCHER از خودِ MainActivity به این دو alias منتقل شده. -->
        <activity-alias
            android:name=".RealLauncherAlias"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".CalculatorDisguiseAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_calculator_disguise"
            android:label="@string/calculator_disguise_label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- برای باز کردن لینک جلسهٔ زندهٔ خارجی (Zoom/Meet/Jitsi) با url_launcher -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
