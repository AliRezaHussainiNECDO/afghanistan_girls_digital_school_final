<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- رفع اشکال «flutter run» → «package identifier or launch activity not found»:
         در Manifest اصلی (main/AndroidManifest.xml)، intent-filter LAUNCHER عمداً از
         خودِ MainActivity به دو activity-alias («حالت پنهان») منتقل شده تا فقط یکی از
         آن دو (نمایهٔ واقعی/نمایهٔ ماشین‌حساب) آیکون برنامه را در Launcher نشان دهد.
         ابزار flutter run هنگام پیداکردن activity برای اجرا، فقط <activity> با
         intent-filter LAUNCHER را می‌شناسد و <activity-alias> را نادیده می‌گیرد؛ در
         نتیجه در حالت debug اصلاً نمی‌تواند برنامه را پیدا/اجرا کند. راه‌حل: فقط در
         نسخهٔ debug (این فایل، که هنگام Build با Manifest اصلی ادغام/Merge می‌شود و
         روی نسخهٔ release/production در Play Store اصلاً اثر نمی‌گذارد)، همان
         intent-filter را مستقیماً به MainActivity هم اضافه می‌کنیم تا flutter run آن
         را پیدا کند. عارضهٔ جانبی: در بیلدهای debug، یک آیکون برنامهٔ اضافه (کنار
         نمایهٔ فعال) در App Drawer دیده می‌شود — کاملاً بی‌ضرر و فقط مخصوص توسعه است. -->
    <application>
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
