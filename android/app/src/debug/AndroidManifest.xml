<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- توجه: راه‌حل قبلیِ «افزودن intent-filter LAUNCHER فقط در این فایل»
         اشتباه بود و مشکل «flutter run → package identifier or launch
         activity not found» را واقعاً حل نمی‌کرد، چون ابزار flutter برای
         تشخیص launch activity فقط android/app/src/main/AndroidManifest.xml
         را می‌خواند، نه نسخهٔ merge‌شدهٔ Gradle این overlay را (نگاه کنید:
         github.com/flutter/flutter/issues/134018). رفع اشکال واقعی الان
         مستقیماً در همان فایل اصلی انجام شده (با android:enabled کنترل‌شده
         توسط manifestPlaceholders در android/app/build.gradle.kts)، پس اینجا
         دیگر نیازی به تعریف تکراری MainActivity نیست. -->
</manifest>
